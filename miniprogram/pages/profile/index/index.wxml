<view class="profile-page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
    <view class="user-info">
      <text class="nickname">{{userInfo.nickName || '早起的鸟儿'}}</text>
      <text class="location">{{userInfo.province}} · {{userInfo.city}}</text>
      <view class="edit-btn" bindtap="goToEdit">
        <text>编辑资料</text>
      </view>
    </view>
  </view>

  <!-- 统计数据 -->
  <stat-card items="{{statItems}}" />

  <!-- 功能列表 -->
  <van-cell-group class="function-card">
    <van-cell 
      title="打卡记录" 
      icon="clock-o" 
      is-link 
      bindtap="goToRecords"
    />
    <van-cell 
      title="统计分析" 
      icon="chart-trending-o" 
      is-link 
      bindtap="goToStatistics"
    />
  </van-cell-group>

  <!-- 设置列表 -->
  <van-cell-group class="function-card">
    <van-cell 
      title="设置" 
      icon="setting-o" 
      is-link 
      bindtap="goToSettings"
    />
    <van-cell 
      title="关于" 
      icon="info-o" 
      is-link 
      bindtap="goToAbout"
    />
  </van-cell-group>
</view>
