<view class="profile-page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <image class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
    <view class="user-info">
      <text class="nickname">{{userInfo.nickName || '早起的鸟儿'}}</text>
      <text class="location">{{userInfo.province}} · {{userInfo.city}}</text>
      <view class="edit-btn" bindtap="goToEdit">
        <text>编辑资料</text>
      </view>
    </view>
  </view>

  <!-- 统计数据 -->
  <stat-card items="{{statItems}}" />

  <!-- 功能列表 -->
  <view class="function-card">
    <view class="function-item" bindtap="goToRecords">
      <text class="function-icon">📅</text>
      <text class="function-text">打卡记录</text>
      <text class="arrow">›</text>
    </view>
    <view class="function-item" bindtap="goToStatistics">
      <text class="function-icon">📊</text>
      <text class="function-text">统计分析</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 设置列表 -->
  <view class="function-card">
    <view class="function-item" bindtap="goToSettings">
      <text class="function-icon">⚙️</text>
      <text class="function-text">设置</text>
      <text class="arrow">›</text>
    </view>
    <view class="function-item" bindtap="goToAbout">
      <text class="function-icon">❓</text>
      <text class="function-text">关于</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
