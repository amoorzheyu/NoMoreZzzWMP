<view class="settings-page">
  <view class="settings-section">
    <view class="setting-item">
      <text class="setting-label">清除缓存</text>
      <button class="setting-btn" bindtap="clearCache">
        <text>清除</text>
      </button>
    </view>
  </view>

  <view class="logout-btn" bindtap="handleLogout">
    <text>退出登录</text>
  </view>
</view>
