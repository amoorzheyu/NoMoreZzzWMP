<view class="settings-page">
  <!-- 设置项 -->
  <van-cell-group class="settings-section">
    <van-cell 
      title="清除缓存" 
      icon="delete-o"
      is-link
      bindtap="clearCache"
    />
  </van-cell-group>

  <!-- 退出登录 -->
  <view class="logout-container">
    <van-button 
      type="danger" 
      plain 
      round 
      block
      bindtap="handleLogout"
    >
      退出登录
    </van-button>
  </view>

  <!-- 确认弹窗 -->
  <van-dialog 
    id="van-dialog"
    use-slot
  />
</view>
