<view class="edit-page">
  <!-- 头像 -->
  <view class="avatar-section">
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view class="avatar-mask">
        <van-icon name="photograph" size="32rpx" color="#fff" />
      </view>
    </button>
    <text class="avatar-tip">点击修改头像</text>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <!-- 昵称 -->
    <van-field
      label="昵称"
      value="{{nickName}}"
      type="nickname"
      placeholder="请输入昵称"
      border="{{ false }}"
      bind:change="onNickNameInput"
    />

    <!-- 性别 -->
    <view class="form-item gender-item">
      <text class="form-label">性别</text>
      <view class="gender-selector">
        <view 
          class="gender-option {{gender === 1 ? 'active' : ''}}"
          bindtap="selectGender"
          data-gender="1"
        >
          <text>男</text>
        </view>
        <view 
          class="gender-option {{gender === 2 ? 'active' : ''}}"
          bindtap="selectGender"
          data-gender="2"
        >
          <text>女</text>
        </view>
      </view>
    </view>

    <!-- 个性签名 -->
    <van-field
      label="个性签名"
      value="{{signature}}"
      type="textarea"
      placeholder="写点什么吧..."
      maxlength="50"
      show-word-limit
      autosize
      border="{{ false }}"
      bind:change="onSignatureInput"
    />
  </view>

  <!-- 保存按钮 -->
  <view class="btn-container">
    <van-button 
      type="primary" 
      round 
      block
      bindtap="handleSave"
    >
      保存
    </van-button>
  </view>
</view>
