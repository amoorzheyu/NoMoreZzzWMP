<view class="edit-page">
  <view class="form-section">
    <!-- 头像 -->
    <view class="form-item">
      <text class="form-label">头像</text>
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      </button>
    </view>

    <!-- 昵称 -->
    <view class="form-item">
      <text class="form-label">昵称</text>
      <input 
        class="form-input" 
        type="nickname"
        value="{{nickName}}" 
        placeholder="请输入昵称"
        bindinput="onNickNameInput"
      />
    </view>

    <!-- 性别 -->
    <view class="form-item">
      <text class="form-label">性别</text>
      <view class="gender-selector">
        <view 
          class="gender-item {{gender === 1 ? 'active' : ''}}"
          bindtap="selectGender"
          data-gender="1"
        >
          <text>男</text>
        </view>
        <view 
          class="gender-item {{gender === 2 ? 'active' : ''}}"
          bindtap="selectGender"
          data-gender="2"
        >
          <text>女</text>
        </view>
      </view>
    </view>

    <!-- 个性签名 -->
    <view class="form-item">
      <text class="form-label">个性签名</text>
      <textarea 
        class="form-textarea" 
        value="{{signature}}" 
        placeholder="写点什么吧..."
        maxlength="50"
        bindinput="onSignatureInput"
      />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-btn" bindtap="handleSave">
    <text>保存</text>
  </view>
</view>
