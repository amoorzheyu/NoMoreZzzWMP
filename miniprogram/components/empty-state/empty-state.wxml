<!-- 空状态组件 - 温暖的反馈 -->
<view class="empty-state">
  <text class="empty-icon">{{icon}}</text>
  <text class="empty-title">{{title}}</text>
  <text class="empty-desc" wx:if="{{description}}">{{description}}</text>
  <view class="empty-action" wx:if="{{actionText}}" bindtap="handleAction">
    <text>{{actionText}}</text>
  </view>
</view>
