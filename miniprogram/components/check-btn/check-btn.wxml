<view class="check-btn-wrapper {{checked ? 'checked' : ''}} {{pressing ? 'pressing' : ''}} {{animating ? 'animating' : ''}}">
  <van-button 
    class="check-btn"
    custom-class="check-btn-custom"
    round
    type="default"
    custom-style="width: 160rpx; height: 160rpx; border-radius: 80rpx; border: none;"
    hover-class="none"
    bindtouchstart="onTouchStart"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchCancel"
    bindtap="handleTap"
  >
    <view class="btn-content">
      <text class="btn-text" wx:if="{{!checked}}">醒了</text>
      <view class="checked-content" wx:else>
        <text class="check-icon">✓</text>
        <text class="check-time">{{checkTime}}</text>
      </view>
    </view>
  </van-button>
</view>
